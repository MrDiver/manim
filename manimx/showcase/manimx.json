{
  "$schema": "./.manimx/project.schema.json",
  "format": 2,
  "name": "showcase",
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "background": "#0b1020",
    "background_opacity": 1.0,
    "antialiasing": 4,
    "audio": true,
    "sample_rate": 48000,
    "directory": "renders"
  },
  "effects": {
    "motion_blur": {
      "enabled": true,
      "samples": 8,
      "shutter_angle": 180.0
    },
    "bloom": {
      "enabled": true,
      "intensity": 0.1,
      "threshold": 1.0,
      "knee": 0.5,
      "radius": 1.0,
      "levels": 6
    },
    "shadows": {
      "enabled": true,
      "softness": 1.0,
      "samples": 16,
      "resolution": 2048
    },
    "tone_map": {
      "operator": "pbr_neutral",
      "exposure": 1.0
    }
  },
  "lighting": {
    "ambient_color": "#ffffff",
    "ambient_intensity": 0.15,
    "default_lights": true
  },
  "performance": {
    "workers": 1,
    "frames_in_flight": 3,
    "core": true
  },
  "scenes": {
    "Shapes": {
      "module": "scenes.shapes",
      "class": "Shapes"
    },
    "Signals": {
      "module": "scenes.signals",
      "class": "Signals"
    },
    "Text": {
      "module": "scenes.text",
      "class": "Text"
    },
    "Measures": {
      "module": "scenes.measures",
      "class": "Measures"
    },
    "Morphing": {
      "module": "scenes.morphing",
      "class": "Morphing"
    },
    "Clipping": {
      "module": "scenes.clipping",
      "class": "Clipping"
    },
    "Solids": {
      "module": "scenes.solids",
      "class": "Solids"
    },
    "Cameras": {
      "module": "scenes.cameras",
      "class": "Cameras"
    },
    "Shaders": {
      "module": "scenes.shaders",
      "class": "Shaders"
    },
    "Physics": {
      "module": "scenes.physics",
      "class": "Physics"
    },
    "LowerThird": {
      "module": "scenes.lower_third",
      "class": "LowerThird"
    }
  },
  "timeline": {
    "clips": [
      {
        "scene": "Shapes"
      },
      {
        "scene": "Signals"
      },
      {
        "scene": "Text"
      },
      {
        "scene": "Morphing"
      },
      {
        "scene": "Clipping"
      },
      {
        "scene": "Solids"
      },
      {
        "scene": "Cameras"
      },
      {
        "scene": "Shaders"
      },
      {
        "scene": "Physics"
      },
      {
        "scene": "Measures"
      },
      {
        "scene": "LowerThird",
        "start": 45.7,
        "layer": 1
      }
    ],
    "events": {}
  }
}
