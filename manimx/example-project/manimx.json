{
  "$schema": "./.manimx/project.schema.json",
  "format": 1,
  "name": "example-project",
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "background": "#0b1020",
    "motion_blur": 8,
    "audio": true,
    "sample_rate": 48000,
    "directory": "renders"
  },
  "performance": {
    "workers": 1,
    "frames_in_flight": 3
  },
  "scenes": {
    "Intro": {
      "module": "scenes.intro",
      "class": "Intro"
    },
    "Bounce": {
      "module": "scenes.bounce",
      "class": "Bounce"
    },
    "Outro": {
      "module": "scenes.outro",
      "class": "Outro"
    },
    "PortalOrbit": {
      "module": "scenes.portal_orbit",
      "class": "PortalOrbit"
    }
  },
  "timeline": {
    "clips": [
      {
        "scene": "Intro"
      },
      {
        "scene": "Bounce"
      },
      {
        "scene": "Outro"
      },
      {
        "scene": "PortalOrbit"
      }
    ],
    "events": {}
  }
}
